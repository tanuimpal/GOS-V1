# Copy to .env.local. This file contains no credentials.
# Development needs no database; readiness truthfully reports it as unconfigured.
ENVIRONMENT=development
LOG_LEVEL=info
DATABASE_URL=
DATABASE_SSL=disable
# Exact comma-separated browser origins; empty disables requests carrying Origin.
# Same-origin GET requests without Origin keep working. No wildcard/credentials.
API_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# For staging/production use only explicit HTTPS origins, including the deployed UI.

# A production/staging runtime requires ENVIRONMENT, a real DATABASE_URL and
# DATABASE_SSL=require. Use a trusted certificate; do not disable TLS validation.
# PostgreSQL URL SSL query parameters are deliberately rejected; use DATABASE_SSL.
# API calls are same-origin, so no public API URL or secret is needed.
# Login/session issuance and AI providers are not connected yet; do not invent secrets.

# Razorpay billing: server-only; never prefix secrets with NEXT_PUBLIC_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test
# Billing reads existing verified __Host-gos_session cookies; a login adapter is required.
BILLING_GRACE_DAYS=7
# Monthly mandate length (finite; no automatic mandate replacement at completion).
BILLING_TOTAL_COUNT=120
# JSON mapping of approved internal plan codes to Razorpay monthly plan IDs. No fake prices.
BILLING_PLAN_MAPPING={}
# Operator-only migration connection; runtime DATABASE_URL must use a non-owner,
# non-superuser, non-BYPASSRLS login granted gos_billing_runtime. Do not deploy this variable.
BILLING_MIGRATION_DATABASE_URL=

# Meta organic social integration. Server only; no NEXT_PUBLIC_ credentials.
META_APP_ID=
META_APP_SECRET=
META_APP_ORIGIN=
META_GRAPH_API_VERSION=v25.0
# Facebook Login for Business configurations using USER access tokens.
# Facebook: pages_show_list,pages_read_engagement
# Instagram: those two plus instagram_basic,instagram_manage_insights
META_FACEBOOK_LOGIN_CONFIG_ID=
META_INSTAGRAM_LOGIN_CONFIG_ID=
# AES-256-GCM keyring: JSON object of key ID -> random 32-byte base64 key.
# Keep old keys during rotation; change the active ID only after provisioning its key.
META_TOKEN_KEY_ID=
META_TOKEN_KEYS={}
SOCIAL_FRESHNESS_HOURS=72
# Operator only; do not deploy. Runtime login also needs gos_social_runtime.
SOCIAL_MIGRATION_DATABASE_URL=

# Temporary local-only preview access; remove this block when finished.
GOS_DEMO_AUTH_ENABLED=true
GOS_DEMO_SESSION_SECRET=75fe1c16cf9da73068b05f5185f6bb9387f10b512eb9e66cdfe721c8d32f33e5
