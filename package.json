{
  "name": "gos-foundation",
  "version": "0.1.0",
  "private": true,
  "description": "Growth By TI — GOS foundation, dashboard demos and secured Razorpay subscription billing; provider activation requires setup.",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11 <13"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "test": "npm run test:unit && npm run test:components && npm run test:integration",
    "test:unit": "node --conditions=react-server --import tsx --test tests/unit/*.test.ts",
    "test:components": "node --import tsx --test tests/components/*.test.tsx",
    "test:integration": "node --conditions=react-server --import tsx --test tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "test:billing-ui": "node --conditions=react-server --import tsx --test tests/browser/billing.test.ts",
    "lint": "eslint . --max-warnings=0",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:check": "node --conditions=react-server --import tsx scripts/check-database.ts",
    "verify": "npm run lint && npm run type-check && npm test && npm run build",
    "billing:migrate": "node --conditions=react-server --import tsx scripts/migrate-billing.ts --apply",
    "billing:sync-plans": "node --conditions=react-server --import tsx scripts/billing.ts sync-plans",
    "billing:process-webhooks": "node --conditions=react-server --import tsx scripts/billing.ts process-webhooks",
    "billing:reconcile": "node --conditions=react-server --import tsx scripts/billing.ts reconcile",
    "social:migrate": "node --conditions=react-server --import tsx scripts/migrate-social.ts --apply",
    "social:process-syncs": "node --conditions=react-server --import tsx scripts/social.ts process-syncs",
    "test:social-ui": "node --conditions=react-server --import tsx --test tests/browser/social.test.ts"
  },
  "dependencies": {
    "@next/env": "16.4.6",
    "@workos-inc/authkit-nextjs": "4.6.2",
    "@workos-inc/node": "12.0.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@electric-sql/pglite-socket": "0.2.12",
    "@playwright/test": "1.62.1",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "type": "module"
}
